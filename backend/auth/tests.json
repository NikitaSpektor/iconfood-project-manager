{
  "tests": [
    {
      "name": "Список участников",
      "method": "GET",
      "path": "/?action=members",
      "expectedStatus": 200
    },
    {
      "name": "Неверный пароль",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "login",
        "login": "elena.metla",
        "password": "wrong"
      },
      "expectedStatus": 401
    },
    {
      "name": "Правка сотрудника без входа запрещена",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "update",
        "login": "elena.metla",
        "name": "Тест",
        "email": "t@iconfood.ru"
      },
      "expectedStatus": 401
    },
    {
      "name": "Отключение без входа запрещено",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "dismiss",
        "login": "elena.metla"
      },
      "expectedStatus": 401
    },
    {
      "name": "Сброс пароля без входа запрещён",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "reset_password",
        "login": "elena.metla"
      },
      "expectedStatus": 401
    },
    {
      "name": "Смена пароля без входа запрещена",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "change_password",
        "current": "iconfood",
        "password": "newpass123"
      },
      "expectedStatus": 401
    },
    {
      "name": "Успешный вход",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "login",
        "login": "elena.metla",
        "password": "iconfood"
      },
      "expectedStatus": 200
    },
    {
      "name": "Запрос кода для неизвестного логина — нейтральный ответ",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "forgot",
        "login": "nobody.unknown"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Неверный код не меняет пароль",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "reset_confirm",
        "login": "nobody.unknown",
        "code": "000000",
        "password": "qwerty123"
      },
      "expectedStatus": 400
    }
  ]
}